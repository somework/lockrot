parameters:
    level: max
    phpVersion: 70400
    paths: [src]
    treatPhpDocTypesAsCertain: false
    # phpstan reads the newest Composer. AuditConfig::fromConfig() exists on Composer 2.9 only,
    # behind a capability probe in each reader.
    ignoreErrors:
        -
            identifier: staticMethod.notFound
            path: src/Data/Abandoned/ComposerAbandonedPolicyReader.php
        -
            identifier: staticMethod.notFound
            path: src/Data/Advisory/ComposerAdvisoryPolicyReader.php
