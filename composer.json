{
    "name": "somework/lockrot",
    "description": "Finds abandoned, unmaintained and branch-pinned packages in composer.lock. Composer plugin and standalone PHAR with CI exit codes.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "composer",
        "composer-plugin",
        "composer.lock",
        "dependencies",
        "dependency-management",
        "abandoned",
        "unmaintained",
        "maintenance",
        "stale",
        "audit",
        "dependency-rot",
        "supply-chain",
        "ci",
        "sarif"
    ],
    "homepage": "https://lockrot.dev",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com",
            "homepage": "https://github.com/somework"
        }
    ],
    "support": {
        "issues": "https://github.com/somework/lockrot/issues",
        "source": "https://github.com/somework/lockrot",
        "docs": "https://lockrot.dev/",
        "security": "https://github.com/somework/lockrot/security/policy"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "composer-plugin-api": "^2.2"
    },
    "suggest": {
        "ext-openssl": "Lets lockrot.phar self-update verify release signatures; checked at runtime, the plugin itself never needs it"
    },
    "require-dev": {
        "composer/composer": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.70",
        "nikic/php-parser": "^5.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "symfony/console": "^5.4",
        "symfony/process": "^5.4"
    },
    "autoload": { "psr-4": { "Lockrot\\": "src/" } },
    "autoload-dev": { "psr-4": { "Lockrot\\Tests\\": "tests/" } },
    "extra": {
        "class": "Lockrot\\Composer\\LockrotPlugin",
        "plugin-modifies-downloads": false
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse -c phpstan.tests.neon.dist --memory-limit=1G"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
