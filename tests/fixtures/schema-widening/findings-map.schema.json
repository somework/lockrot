{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "A map keyed by package name, closed, with no x-known-keys, as a -2 baseline holds its findings (SchemaWideningTest)",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "description": "Package name to what the baseline knows about it.",
      "type": "object",
      "patternProperties": {"^[^\\/]+\\/[^\\/]+$": {"$ref": "#/definitions/entry"}},
      "additionalProperties": false
    }
  },
  "definitions": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "entry": {
      "type": "object",
      "required": ["version", "first_seen"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "first_seen": {"$ref": "#/definitions/date"},
        "flags": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "abandoned": {"type": "object", "required": ["known_since"], "properties": {"known_since": {"$ref": "#/definitions/date"}}},
            "silent": {"type": "object", "required": ["known_since"], "properties": {"known_since": {"$ref": "#/definitions/date"}}}
          }
        },
        "advisories": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}}
      },
      "anyOf": [{"required": ["flags"]}, {"required": ["advisories"]}]
    }
  }
}
