{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "lockrot",
                    "version": "0.13.0",
                    "informationUri": "https://github.com/somework/lockrot",
                    "rules": [
                        {
                            "id": "lockrot/abandoned",
                            "name": "abandoned",
                            "shortDescription": {
                                "text": "abandoned: Package is marked abandoned by its repository, or its repository is archived"
                            },
                            "fullDescription": {
                                "text": "The package's Composer repository marks it abandoned (Packagist by default), or its repository is archived on GitHub or GitLab."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/silent",
                            "name": "silent",
                            "shortDescription": {
                                "text": "silent: No stable release and no repository push for a long time"
                            },
                            "fullDescription": {
                                "text": "No stable release for at least release-high-years (default 5 years) and no repository push for at least push-high-years (default 5 years); an archived repository is reported as abandoned instead."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/stale",
                            "name": "stale",
                            "shortDescription": {
                                "text": "stale: Old release or old push, below the silent thresholds"
                            },
                            "fullDescription": {
                                "text": "Old release or old push, but not old enough \u2014 or not on both fronts \u2014 for silent."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/advisories-unchecked",
                            "name": "advisories-unchecked",
                            "shortDescription": {
                                "text": "advisories-unchecked: The advisories of some packages were not checked"
                            },
                            "fullDescription": {
                                "text": "The gate could not read the advisories of every package. It is an error when --fail-on=unchecked fails on the gap."
                            },
                            "defaultConfiguration": {
                                "level": "note"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        }
                    ]
                }
            },
            "columnKind": "utf16CodeUnits",
            "results": [
