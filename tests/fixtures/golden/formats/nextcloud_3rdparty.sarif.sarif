{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "lockrot",
                    "version": "0.13.0",
                    "informationUri": "https://github.com/somework/lockrot",
                    "rules": [
                        {
                            "id": "lockrot/silent",
                            "name": "silent",
                            "shortDescription": {
                                "text": "silent: No stable release and no repository push for a long time"
                            },
                            "fullDescription": {
                                "text": "No stable release for release-high-years and no repository push for push-high-years."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/abandoned",
                            "name": "abandoned",
                            "shortDescription": {
                                "text": "abandoned: Package is marked abandoned, or its repository is archived"
                            },
                            "fullDescription": {
                                "text": "The package's registry or composer.lock marks it abandoned, or its repository is archived."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/stale",
                            "name": "stale",
                            "shortDescription": {
                                "text": "stale: Old release or old push, below the silent thresholds"
                            },
                            "fullDescription": {
                                "text": "No stable release or no repository push for release-warn-years or push-warn-years."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/advisories-unchecked",
                            "name": "advisories-unchecked",
                            "shortDescription": {
                                "text": "advisories-unchecked: The advisories of some packages were not checked"
                            },
                            "fullDescription": {
                                "text": "The gate could not read the advisories of every package. It is an error when --fail-on=unchecked fails on the gap."
                            },
                            "defaultConfiguration": {
                                "level": "note"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        }
                    ]
                }
            },
            "columnKind": "utf16CodeUnits",
