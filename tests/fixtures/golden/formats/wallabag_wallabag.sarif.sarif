{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "lockrot",
                    "version": "0.13.0",
                    "informationUri": "https://github.com/somework/lockrot",
                    "rules": [
                        {
                            "id": "lockrot/silent",
                            "name": "silent",
                            "shortDescription": {
                                "text": "silent: No stable release and no repository push for a long time"
                            },
                            "fullDescription": {
                                "text": "No release for 5 years (release-high-years) and no repository push for 5 years (push-high-years)."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/old-promise",
                            "name": "old-promise",
                            "shortDescription": {
                                "text": "old-promise: Released before the target PHP's major with an open-ended php constraint"
                            },
                            "fullDescription": {
                                "text": "The installed version was released before the target PHP's GA date, and its php constraint admits that target untested."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/abandoned",
                            "name": "abandoned",
                            "shortDescription": {
                                "text": "abandoned: Package is marked abandoned, or its repository is archived"
                            },
                            "fullDescription": {
                                "text": "The package's registry or composer.lock marks it abandoned, or its repository is archived."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/pinned",
                            "name": "pinned",
                            "shortDescription": {
                                "text": "pinned: Installed version is a branch snapshot, or the package has no stable release"
                            },
                            "fullDescription": {
                                "text": "The installed version is a branch snapshot (dev-* or #hash), or the package has no stable release at all."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/stale",
                            "name": "stale",
                            "shortDescription": {
                                "text": "stale: Old release or old push, below the silent thresholds"
                            },
                            "fullDescription": {
                                "text": "No release for 3 years (release-warn-years), or no repository push for 3 years (push-warn-years), short of silent."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/left-behind",
                            "name": "left-behind",
                            "shortDescription": {
                                "text": "left-behind: The installed release branch stopped while a newer branch kept releasing"
                            },
                            "fullDescription": {
                                "text": "No stable release on the installed branch for 3 years (release-warn-years), while a higher branch has released since."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/capped",
                            "name": "capped",
                            "shortDescription": {
                                "text": "capped: The installed version's php constraint stops below the newest PHP the project allows"
                            },
                            "fullDescription": {
                                "text": "The installed version's php requirement has an upper bound below the newest PHP minor that the project allows."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        },
                        {
                            "id": "lockrot/advisories-unchecked",
                            "name": "advisories-unchecked",
                            "shortDescription": {
                                "text": "advisories-unchecked: The advisories of some packages were not checked"
                            },
                            "fullDescription": {
                                "text": "The gate could not read the advisories of every package. It is an error when --fail-on=unchecked fails on the gap."
                            },
                            "defaultConfiguration": {
                                "level": "note"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/",
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ]
                            }
                        }
                    ]
                }
            },
            "columnKind": "utf16CodeUnits",
