{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "lockrot",
                    "version": "0.13.0",
                    "informationUri": "https://github.com/somework/lockrot",
                    "rules": [
                        {
                            "id": "lockrot/abandoned",
                            "name": "abandoned",
                            "shortDescription": {
                                "text": "abandoned: Package is marked abandoned by its repository, or its repository is archived"
                            },
                            "fullDescription": {
                                "text": "The package's Composer repository marks it abandoned (Packagist by default), or its repository is archived on GitHub or GitLab."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/silent",
                            "name": "silent",
                            "shortDescription": {
                                "text": "silent: No stable release and no repository push for a long time"
                            },
                            "fullDescription": {
                                "text": "No stable release for at least release-high-years (default 5 years) and no repository push for at least push-high-years (default 5 years); an archived repository is reported as abandoned instead."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/pinned",
                            "name": "pinned",
                            "shortDescription": {
                                "text": "pinned: Installed version is a branch snapshot, or the package has no stable release"
                            },
                            "fullDescription": {
                                "text": "The installed version is a branch snapshot (dev-* or #hash), or the package has no stable release at all."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/left-behind",
                            "name": "left-behind",
                            "shortDescription": {
                                "text": "left-behind: The installed release branch stopped while a newer branch kept releasing"
                            },
                            "fullDescription": {
                                "text": "No stable release on the installed version's branch for at least release-high-years (default 5 years), while a higher branch has released since: the package is alive, the branch installed here gets no fixes."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/old-promise",
                            "name": "old-promise",
                            "shortDescription": {
                                "text": "old-promise: Released before the target PHP's GA date with an open-ended php constraint"
                            },
                            "fullDescription": {
                                "text": "The installed version was released before the target PHP's GA date, and its require.php constraint is open-ended (>=N, *) for that target."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/stale",
                            "name": "stale",
                            "shortDescription": {
                                "text": "stale: Old release or old push, below the silent thresholds"
                            },
                            "fullDescription": {
                                "text": "Old release or old push, but not old enough \u2014 or not on both fronts \u2014 for silent."
                            },
                            "defaultConfiguration": {
                                "level": "warning"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        },
                        {
                            "id": "lockrot/advisories-not-checked",
                            "name": "advisories-not-checked",
                            "shortDescription": {
                                "text": "advisories-not-checked: The advisories of some packages were not checked"
                            },
                            "fullDescription": {
                                "text": "The gate could not read the advisories of every package. It is an error when --fail-on=unchecked fails on the gap."
                            },
                            "defaultConfiguration": {
                                "level": "note"
                            },
                            "helpUri": "https://lockrot.dev/verdicts/"
                        }
                    ]
                }
            },
            "columnKind": "utf16CodeUnits",
            "results": [
