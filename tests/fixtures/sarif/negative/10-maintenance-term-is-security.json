       "shortDescription": {
        "text": "left-behind: The installed release branch stopped while a newer branch kept releasing"
       },
       "fullDescription": {
        "text": "No stable release on the installed branch for release-warn-years, while a higher branch has released since."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "helpUri": "https://lockrot.dev/verdicts/",
       "properties": {
        "tags": [
         "maintainability"
        ]
       }
      },
      {
       "id": "lockrot/old-promise",
       "name": "old-promise",
       "shortDescription": {
        "text": "old-promise: Released before the target PHP's major with an open-ended php constraint"
       },
       "fullDescription": {
        "text": "The installed version was released before the target PHP's GA date, and its php constraint admits that target untested."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "helpUri": "https://lockrot.dev/verdicts/",
       "properties": {
        "tags": [
         "maintainability"
        ]
