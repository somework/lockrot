# Test fixtures include a small PHP archive; never let it through line-ending normalisation.
*.phar binary
# The documents older releases wrote are checked against the sha256 their recording took.
/tests/fixtures/schema-evolution/** -text
# tools/score/sweep.py's output, gzipped: no text diff of the gzip, and GitHub folds it in a pull request.
/tests/fixtures/score/sweep-rows.txt.gz binary linguist-generated
# tools/corpus/floor.py's output, gzipped, and the priorities that tools/fixtures/record-legacy-priority.php records.
/tests/fixtures/corpus/report-1-floor.json.gz binary linguist-generated
/tests/fixtures/legacy/priority-0.13.0.json linguist-generated

