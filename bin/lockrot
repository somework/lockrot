#!/usr/bin/env php
<?php

declare(strict_types=1);

// The same floor as the plugin ("php": "^7.4 || ^8.0" in composer.json) and as the PHAR's own
// requirement check (it is built against platform PHP 7.4.0, see build/phar/composer.json), so a
// checkout run on an older PHP fails the same way the PHAR does, with one line instead of a parse error.
if (\PHP_VERSION_ID < 70400) {
    fwrite(\STDERR, "lockrot requires PHP 7.4 or newer\n");
    exit(2);
}

foreach ([
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
    __DIR__.'/../build/phar/vendor/autoload.php',
] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(\Composer\Console\Application::class)) {
    fwrite(\STDERR, "composer/composer is not installed; run composer install in build/phar\n");
    exit(2);
}

putenv('COMPOSER_DISABLE_XDEBUG_WARN=1');

// Raise memory_limit the way Composer's own binary does before it builds the Application: honour
// COMPOSER_MEMORY_LIMIT when set, otherwise lift a limit lower than 1.5G up to 1536M and leave an
// unlimited (-1) limit alone. Without this the PHAR dies on large lock files at PHP's default 128M,
// where the plugin path inherits the bump from `composer` itself.
$lockrotMemoryLimit = getenv('COMPOSER_MEMORY_LIMIT');
if (\is_string($lockrotMemoryLimit) && $lockrotMemoryLimit !== '') {
    @ini_set('memory_limit', $lockrotMemoryLimit);
} else {
    $lockrotMemoryInBytes = static function (string $value): int {
        $multipliers = ['g' => 1024 * 1024 * 1024, 'm' => 1024 * 1024, 'k' => 1024];
        $unit = strtolower(substr($value, -1, 1));

        return (int) $value * ($multipliers[$unit] ?? 1);
    };
    $lockrotCurrentLimit = trim((string) \ini_get('memory_limit'));
    if ($lockrotCurrentLimit !== '-1' && $lockrotMemoryInBytes($lockrotCurrentLimit) < 1024 * 1024 * 1536) {
        @ini_set('memory_limit', '1536M');
    }
    unset($lockrotMemoryInBytes, $lockrotCurrentLimit);
}
unset($lockrotMemoryLimit);

// The PHAR inspects someone else's project; booting that project's Composer plugins would run
// third-party code lockrot never needs. Composer reads $_SERVER['argv'] itself (Application::run()
// builds its own ArgvInput), so --no-plugins is injected here rather than parsed. The plugin path
// (composer lockrot) is unaffected: this file is the PHAR entry point only.
$lockrotArgv = $_SERVER['argv'] ?? [];
if (\is_array($lockrotArgv) && !\in_array('--no-plugins', $lockrotArgv, true)) {
    array_splice($lockrotArgv, 1, 0, ['--no-plugins']);
    $_SERVER['argv'] = $lockrotArgv;
    $_SERVER['argc'] = \count($lockrotArgv);
}
unset($lockrotArgv);

// `lockrot.phar --version` should print one line about lockrot. Composer's Application
// getLongVersion() appends Composer's own release date, and its doRun() adds a PHP-version line
// plus a "diagnose" hint after the version is printed. Both are untyped in the older supported
// Composer, so narrowing the return types in this subclass is allowed.
$application = new class () extends \Composer\Console\Application {
    /**
     * Every command name this build answers to: lockrot's own two, plus Symfony's help, listing and
     * shell-completion commands. Aliases (`rot`, `selfupdate`) travel with their command and are
     * registered by Symfony, so only the primary names appear here.
     */
    private const KEEP = ['lockrot', 'self-update', 'help', 'list', 'completion', '_complete'];

    /** Whether COMPOSER currently points at the null device; see doRun(). */
    private bool $manifestHidden = false;

    /** @var string|false the caller's own COMPOSER value, false when it was unset */
    private $previousComposerEnv = false;

    /**
     * The PHAR is built on Composer's Application, which registers Composer's whole command set —
     * install, update, require, self-update and the rest. The commands are filtered rather than
     * hidden, because a single-command application has no command names at all and
     * `lockrot.phar self-update` could not then be reached.
     *
     * Symfony's own help/list/completion commands are kept (the `list` output is how a user finds
     * `self-update` at all), every Composer project command is dropped — `lockrot.phar update` must
     * never run a Composer update on the project being inspected — and lockrot's two commands are
     * added. Dropping Composer's `self-update` here is also what frees both `self-update` and its
     * `selfupdate` alias for lockrot's own command.
     *
     * @return list<\Symfony\Component\Console\Command\Command>
     */
    protected function getDefaultCommands(): array
    {
        $commands = [];
        foreach (parent::getDefaultCommands() as $command) {
            if (\in_array((string) $command->getName(), self::KEEP, true)) {
                $commands[] = $command;
            }
        }
        $commands[] = new \Lockrot\Composer\LockrotCommand();
        $commands[] = new \Lockrot\Composer\SelfUpdateCommand(null, null, null, self::releaseUrlOverride(), self::releaseKeyOverride());

        return $commands;
    }

    /**
     * The same allowlist applied to every later registration, because getDefaultCommands() is not
     * the only source: Composer\Console\Application::doRun() turns each entry of the inspected
     * project's `scripts` into a runnable command. lockrot reads that project, it does not run it,
     * so those never become lockrot commands.
     *
     * Both spellings are declared. symfony/console < 7.4 registers through add() and Composer picks
     * it with `method_exists($this, 'addCommand') ? $this->addCommand(...) : $this->add(...)`; 7.4
     * and later add addCommand() and deprecate add(). Since declaring addCommand() here makes
     * Composer's `method_exists()` true on every version, add() forwards to it and addCommand()
     * picks the registration path the running symfony/console actually has — so the filter cannot
     * be bypassed by a future resolution, and nothing recurses.
     */
    public function add(\Symfony\Component\Console\Command\Command $command): ?\Symfony\Component\Console\Command\Command
    {
        return $this->addCommand($command);
    }

    public function addCommand(\Symfony\Component\Console\Command\Command $command): ?\Symfony\Component\Console\Command\Command
    {
        if (!\in_array((string) $command->getName(), self::KEEP, true)) {
            return null;
        }

        return method_exists(\Composer\Console\Application::class, 'addCommand')
            ? parent::addCommand($command)
            : parent::add($command);
    }

    /**
     * Where `self-update` looks for the release document, so lockrot's own end-to-end test can point
     * a real PHAR at a local server and watch it replace itself. Empty or unset means GitHub, which
     * is the only value any install ever uses.
     */
    private static function releaseUrlOverride(): ?string
    {
        $url = \Composer\Util\Platform::getEnv('LOCKROT_RELEASE_URL');

        return \is_string($url) && $url !== '' ? $url : null;
    }

    /**
     * The public key `self-update` verifies releases against, as a path to a PEM file, so the same
     * end-to-end test can sign its local releases with a key of its own. Empty or unset means the
     * key built into this archive ({@see \Lockrot\SelfUpdate\ReleaseKey}), which is the only key any
     * install ever uses. Composer's self-update has the same seam in COMPOSER_HOME/keys.tags.pub.
     *
     * The file is read when a signature is checked, not here: every command goes through this
     * factory, and an unreadable path must fail `self-update` through its own error channel, not
     * `lockrot -d project` before it has read a lock.
     */
    private static function releaseKeyOverride(): ?\Lockrot\SelfUpdate\SignatureVerifierInterface
    {
        $path = \Composer\Util\Platform::getEnv('LOCKROT_RELEASE_KEY');
        if (!\is_string($path) || $path === '') {
            return null;
        }

        return new class ($path) implements \Lockrot\SelfUpdate\SignatureVerifierInterface {
            private string $path;

            public function __construct(string $path)
            {
                $this->path = $path;
            }

            public function verify(string $archive, string $signatureFile, string $signatureUrl): void
            {
                $pem = @file_get_contents($this->path);
                if ($pem === false) {
                    throw new \Lockrot\Exception\ConfigException('LOCKROT_RELEASE_KEY names an unreadable file: '.$this->path);
                }
                (new \Lockrot\SelfUpdate\ReleaseSignatureVerifier($pem))->verify($archive, $signatureFile, $signatureUrl);
            }
        };
    }

    public function getLongVersion(): string
    {
        return 'lockrot '.\Lockrot\Version::STRING;
    }

    /**
     * Composer's doRun() preamble reads the inspected project's composer.json before any command
     * runs, and on Composer >= 2.9 that is not a read-only act: for every `scripts` entry whose
     * value looks like a class name it registers the project's own autoloader and calls
     * `class_exists()` on it, which loads the project's file and executes whatever sits at its top
     * level — inside lockrot, with `--no-plugins` offering no protection because this is not the
     * plugin path. The 2.2 LTS line stops short of that (its loop only builds `ScriptAliasCommand`s)
     * but still reads the file.
     *
     * Both loops are gated on `is_file(Factory::getComposerFile())`, and that resolves through the
     * COMPOSER environment variable. So the manifest is hidden for the length of the preamble by
     * pointing COMPOSER at the null device — not a regular file, so `is_file()` is false and the
     * loop never starts, yet `file_exists()` is true, so the "no composer.json in current
     * directory" walk-up stays quiet as well. Composer sets COMPOSER_CACHE_DIR the same way for
     * `--no-cache`.
     *
     * doRunCommand() puts the variable back before the command itself runs, so `lockrot` still sees
     * the project through `tryComposer()` and keeps its configured repositories; the finally covers
     * the paths that never reach a command, such as an unknown command name.
     */
    public function doRun(\Symfony\Component\Console\Input\InputInterface $input, \Symfony\Component\Console\Output\OutputInterface $output): int
    {
        if ($input->hasParameterOption(['--version', '-V'], true)) {
            $output->writeln($this->getLongVersion());

            return 0;
        }

        $this->hideProjectManifest();

        try {
            return parent::doRun($input, $output);
        } finally {
            $this->revealProjectManifest();
        }
    }

    protected function doRunCommand(\Symfony\Component\Console\Command\Command $command, \Symfony\Component\Console\Input\InputInterface $input, \Symfony\Component\Console\Output\OutputInterface $output): int
    {
        $this->revealProjectManifest();

        return parent::doRunCommand($command, $input, $output);
    }

    private function hideProjectManifest(): void
    {
        if ($this->manifestHidden) {
            return;
        }
        $this->previousComposerEnv = \Composer\Util\Platform::getEnv('COMPOSER');
        $this->manifestHidden = true;
        \Composer\Util\Platform::putEnv('COMPOSER', \Composer\Util\Platform::isWindows() ? 'nul' : '/dev/null');
    }

    private function revealProjectManifest(): void
    {
        if (!$this->manifestHidden) {
            return;
        }
        $this->manifestHidden = false;
        if ($this->previousComposerEnv === false) {
            \Composer\Util\Platform::clearEnv('COMPOSER');
        } else {
            \Composer\Util\Platform::putEnv('COMPOSER', $this->previousComposerEnv);
        }
    }
};
$application->setName('lockrot');
$application->setVersion(\Lockrot\Version::STRING);
// `lockrot` is what runs when no command is named, which keeps `lockrot.phar -d project
// --format=json` working while leaving `self-update`, `list` and `help` reachable by name.
$application->setDefaultCommand('lockrot', false);
exit($application->run());
