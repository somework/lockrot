#!/usr/bin/env bash
# Records the README demo from a real run and renders it: asciinema captures the terminal session,
# agg turns the recording into docs/assets/lockrot-demo.gif.
#
#   LOCKROT_DEMO_DIR=<scratch copy of tests/fixtures/apps/koel_koel, holding lockrot.phar> \
#   GITHUB_TOKEN=<token> COMPOSER_CACHE_DIR=<scratch dir> bin/record-demo
#
# Warm Composer's metadata cache with one plain run first. Then delete <cache>/lockrot, so the
# activity round is live and the footer is the plain one. The typing is scripted (the command prints
# one character at a time behind a bare prompt) and the run is real.
set -euo pipefail
gif=$(cd "$(dirname "$0")/.." && pwd)/docs/assets/lockrot-demo.gif
work=$(mktemp -d "${TMPDIR:-/tmp}/lockrot-demo.XXXXXX")
trap 'rm -rf "$work"' EXIT
cast="$work/demo.cast"
: "${LOCKROT_DEMO_DIR:?export LOCKROT_DEMO_DIR}"

session() {
    printf '$ '
    sleep 0.6
    for ((i = 0; i < ${#1}; i++)); do
        printf '%s' "${1:i:1}"
        sleep 0.045
    done
    sleep 0.7
    printf '\n'
    (cd "$LOCKROT_DEMO_DIR" && COLUMNS=110 php lockrot.phar --ansi --target-php=8.4) || true
    sleep 3
}
export -f session

# The exported function only exists for bash, whatever the recorder's login shell is.
# The window is tall enough for the whole report of koel, the prompt and the cursor row in the last
# frame. The idle cap shortens the repository round-trips, which show nothing on screen.
SHELL=/bin/bash asciinema rec --overwrite --quiet --idle-time-limit 2 --window-size 110x37 --command 'session "php lockrot.phar --target-php=8.4"' "$cast"
agg --font-size 18 --line-height 1.3 --theme monokai --speed 1 --last-frame-duration 5 --fps-cap 20 "$cast" "$gif"
ls -la "$gif"
