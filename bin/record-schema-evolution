#!/usr/bin/env bash
# Records what an earlier lockrot release writes, for tests/Integration/SchemaEvolutionTest: the
# baseline file of its `--generate-baseline`, its `--format=json` report compared against that
# baseline and a few `--explain … --format=json` documents, over wallabag's lock.
#
#   GITHUB_TOKEN=$(gh auth token) bin/record-schema-evolution <version> <today>
#
#   <version>  a published release, for example 0.11.0. Its signed lockrot.phar runs.
#   <today>    the recording day, for example 2026-09-25. The clock of lockrot is pinned to its midnight UTC.
set -euo pipefail

usage='usage: GITHUB_TOKEN=$(gh auth token) bin/record-schema-evolution <version> <today>'
version=${1:?$usage}
today=${2:?$usage}
: "${GITHUB_TOKEN:?export GITHUB_TOKEN; $usage}"
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a release version: $version" >&2; exit 2; }
[[ $today =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "not a day: $today" >&2; exit 2; }

php=${PHP:-php}
root=$(cd "$(dirname "$0")/.." && pwd)
out=$root/tests/fixtures/schema-evolution/$version
lock=tests/fixtures/apps/wallabag_wallabag
fingerprint=39ECC3F64AE8D06A9A63FD99AB6F7F52AE513141
target_php=8.4
# A relative path: the report prints the baseline path as given, and an absolute one carries the
# scratch directory into the document.
baseline=lockrot-schema-evolution-baseline.json
# Packages whose explanations between them carry every signal that wallabag's lock has:
#   doctrine/cache abandoned, sensio/framework-extra-bundle abandoned with an archived repository,
#   wallabag/rulerz a pinned branch snapshot, javibravo/simpleue silent with S5, scheb/2fa-backup-code
#   left-behind with S8 and, where the release has it, S10, spomky-labs/otphp left-behind with a
#   security advisory.
packages=(doctrine/cache sensio/framework-extra-bundle wallabag/rulerz javibravo/simpleue scheb/2fa-backup-code spomky-labs/otphp)

# A recorded version is frozen. A document there that stops validating is a compatibility break to
# raise, not a fixture to refresh.
if [[ -e $out ]]; then
    echo "$out exists: a recorded version is never re-recorded" >&2
    exit 1
fi

# The script works in a scratch directory and writes only its result into tests/fixtures.
# GNU and busybox mktemp need the X's in the template, and BSD mktemp accepts them.
work=$(mktemp -d "${TMPDIR:-/tmp}/lockrot-schema-evolution.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/release" "$work/project" "$work/cache-baseline" "$work/cache" "$work/home" "$work/out/explain" "$work/log"
mkdir -m 700 "$work/gnupg"

echo "downloading v$version" >&2
gh release download "v$version" --repo somework/lockrot --dir "$work/release" \
    -p lockrot.phar -p lockrot.phar.sha256 -p lockrot.phar.asc
(cd "$work/release" && shasum -a 256 -c lockrot.phar.sha256 >&2)
# gpgv checks against a keyring that holds the release key alone: it needs no agent and never touches
# your keyring. It does not act on revocations, but it reports them as REVKEYSIG in place of GOODSIG.
# VALIDSIG ends with the fingerprint of the primary key. The grep anchors it, so a key whose
# fingerprint only contains this one does not pass. EXPKEYSIG passes: the subkey that signed an older
# release can be expired, and that does not make its signature less valid.
GNUPGHOME=$work/gnupg gpg --batch --dearmor < "$root/lockrot-release-key.asc" > "$work/release-key.gpg"
gpgv --keyring "$work/release-key.gpg" --status-fd 1 "$work/release/lockrot.phar.asc" "$work/release/lockrot.phar" \
    > "$work/log/gpg-status" 2>/dev/null || true
if grep -q '^\[GNUPG:\] REVKEYSIG ' "$work/log/gpg-status"; then
    echo "lockrot.phar of v$version is signed by a revoked key" >&2
    exit 1
fi
if ! grep -Eq "^\[GNUPG:\] VALIDSIG [0-9A-F]{40} .* $fingerprint\$" "$work/log/gpg-status"; then
    echo "lockrot.phar of v$version is not signed by $fingerprint" >&2
    exit 1
fi
gh attestation verify "$work/release/lockrot.phar" --repo somework/lockrot >&2
phar_sha256=$(shasum -a 256 "$work/release/lockrot.phar" | cut -d' ' -f1)
cp "$root/$lock/composer.json" "$root/$lock/composer.lock" "$work/project/"

# One line per run: "<file>\t<exit>\t<arg>\t<arg>…", with the name of the scratch copy and not its location.
runs=$work/log/runs.tsv
: > "$runs"
cache=$work/cache
lockrot() {
    local file=$1 allowed=$2
    shift 2
    local status=0
    env -i PATH="$PATH" HOME="$work/home" COMPOSER_HOME="$work/home" COMPOSER_CACHE_DIR="$cache" \
        COMPOSER_NO_INTERACTION=1 LOCKROT_TODAY="${today}T00:00:00+00:00" GITHUB_TOKEN="$GITHUB_TOKEN" \
        "$php" -d display_errors=stderr "$work/release/lockrot.phar" -d "$work/project" --target-php="$target_php" --no-ansi "$@" \
        > "$work/log/stdout" 2> "$work/log/stderr" || status=$?
    if [[ " $allowed " != *" $status "* ]]; then
        echo "lockrot $* exited $status" >&2
        cat "$work/log/stderr" >&2
        exit 1
    fi
    local line="$file"$'\t'"$status" arg
    for arg in -d "<copy of $lock>" --target-php="$target_php" --no-ansi "$@"; do
        line+=$'\t'"$arg"
    done
    printf '%s\n' "$line" >> "$runs"
}

echo "recording with lockrot $version" >&2
# The baseline run fills a Composer cache of its own. The report run starts from another, empty one,
# so the report is what the release writes on a fresh machine: every answer is fetched in the run
# and `activity_cache_oldest_at` is null. The explanations run on the cache that the report filled,
# as a second run does, so they carry `from_cache: true`.
cache=$work/cache-baseline
lockrot "$baseline" 0 --generate-baseline --baseline="$baseline"
mv "$work/project/$baseline" "$work/out/$baseline"
cp "$work/out/$baseline" "$work/project/$baseline"
cache=$work/cache
lockrot report.json '0 1' --format=json --baseline="$baseline"
mv "$work/log/stdout" "$work/out/report.json"
# A quoted `~`: bash 4.3 and later tilde-expand an unquoted one in the replacement to $HOME.
tilde='~'
for package in "${packages[@]}"; do
    file="explain/${package/\//$tilde}.json"
    lockrot "$file" 0 --explain="$package" --format=json
    mv "$work/log/stdout" "$work/out/$file"
done

# Each document must be JSON. It must name its schema first and say that $version wrote it under the
# schema number that its `$schema` names. It must carry no token and no path of this machine. A path
# counts only as a whole path: `/lockrot` is in every `https://lockrot.dev/…`, and HOME=/ is in all of them.
for path in "$work/out/$baseline" "$work"/out/report.json "$work"/out/explain/*.json; do
    case $path in
        */report.json) kind=report ;;
        */"$baseline") kind=baseline ;;
        *) kind=explain ;;
    esac
    "$php" -r '
        [, $path, $kind, $version, $token] = $argv;
        $paths = array_slice($argv, 5);
        $json = (string) file_get_contents($path);
        $doc = json_decode($json, true);
        $head = "{\n    \"\$schema\": \"https://lockrot.dev/schema/$kind-";
        $number = is_array($doc) && preg_match("{^https://lockrot\\.dev/schema/$kind-([1-9][0-9]*)\\.json\$}", (string) ($doc["\$schema"] ?? ""), $m) === 1 ? (int) $m[1] : null;
        if (strpos($json, $head) !== 0 || $number === null || ($doc["lockrot"]["version"] ?? null) !== $version || ($doc["lockrot"]["schema"] ?? null) !== $number) {
            fwrite(STDERR, "$path is not a $kind document written by $version\n");
            exit(1);
        }
        if (strpos($json, $token) !== false) {
            fwrite(STDERR, "$path carries the token\n");
            exit(1);
        }
        foreach ($paths as $machine) {
            $machine = rtrim($machine, "/");
            if ($machine === "") {
                continue;
            }
            foreach ([$machine, str_replace("/", "\\/", $machine)] as $form) {
                if (preg_match("{(?<![\\w./\\\\-])".preg_quote($form, "{")."(?![\\w.-])}", $json) === 1) {
                    fwrite(STDERR, "$path carries $machine, a path of this machine\n");
                    exit(1);
                }
            }
        }
    ' "$path" "$kind" "$version" "$GITHUB_TOKEN" "$work" "$(cd "$work" && pwd -P)" "$root" "$HOME"
done

# provenance.json names the release, the sha256 of the PHAR, the PHP that ran it, the arguments of
# every run and the sha256 of every file written. SchemaEvolutionTest pins its sha256 and the digest
# of the release asset.
"$php" -r '
    [, $runs, $out, $version, $sha256, $today, $recorded, $lock, $targetPhp, $fingerprint] = $argv;
    $files = [];
    foreach (file($runs, FILE_IGNORE_NEW_LINES) as $line) {
        $fields = explode("\t", $line);
        $file = $fields[0];
        $files[$file] = ["args" => array_slice($fields, 2), "exit" => (int) $fields[1], "sha256" => hash_file("sha256", $out."/".$file)];
    }
    $provenance = [
        "lockrot" => $version,
        "tag" => "v".$version,
        "phar_sha256" => $sha256,
        "verified" => [
            "sha256" => "lockrot.phar.sha256 of the release",
            "gpg" => $fingerprint,
            "attestation" => "gh attestation verify lockrot.phar --repo somework/lockrot",
        ],
        "recorded" => $recorded,
        "today" => $today,
        "php" => PHP_VERSION,
        "target_php" => $targetPhp,
        "lock" => $lock,
        "network" => true,
        "github_token" => true,
        "cache" => "the baseline run on a cache of its own; the report on an empty one, shared with no other version; the explanations on the cache the report filled",
        "files" => $files,
    ];
    file_put_contents($out."/provenance.json", json_encode($provenance, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES)."\n");
' "$runs" "$work/out" "$version" "$phar_sha256" "${today}T00:00:00+00:00" "$(date -u +%Y-%m-%d)" "$lock" "$target_php" "$fingerprint"

mkdir -p "$(dirname "$out")"
mv "$work/out" "$out"
ls -la "$out" "$out/explain" >&2
echo "recorded $out"
