#!/usr/bin/env php
<?php

declare(strict_types=1);
// Records Composer repository (p2) and GitHub responses for the acceptance fixtures so tests run
// offline. Usage: GITHUB_TOKEN=... bin/record-fixtures [fixtureDir ...]
//
// p2 bodies are trimmed to KEEP (below) before being written; GitHub repo bodies are trimmed
// separately to the keys GitHubApi reads. The fixtures hold GitHub-hosted packages only, so no
// GitLab or Bitbucket answer is recorded. An envelope already on disk is only reused when
// its recorded `status` is not 0 — status 0 means the previous recording run hit a transport
// failure (timeout, DNS, etc.), so it is treated as not-yet-recorded and fetched again.
require __DIR__.'/../vendor/autoload.php';

use Composer\Factory;
use Composer\IO\NullIO;
use Lockrot\Clock;
use Lockrot\Composer\ComposerHttpClient;
use Lockrot\Data\Forge\GitHubApi;
use Lockrot\Data\Forge\RepoLocator;
use Lockrot\Data\Forge\RepoRef;
use Lockrot\Data\Http\HttpResult;
use Lockrot\Data\Http\RecordedHttpClient;
use Lockrot\Data\Repository\MonorepoParents;
use Lockrot\Lock\LockFile;

const KEEP = ['name', 'version', 'version_normalized', 'time', 'abandoned', 'source', 'require', 'replace', 'type', 'extra'];
const REPOSITORY_BASE_URL = 'https://repo.packagist.org/p2/';

$root = \dirname(__DIR__);
$fixtures = $argv;
array_shift($fixtures);
if ($fixtures === []) {
    $fixtures = [
        'tests/fixtures/apps/wallabag_wallabag', 'tests/fixtures/apps/nextcloud_3rdparty', 'tests/fixtures/apps/matomo-org_matomo',
        'tests/fixtures/skeletons/laravel', 'tests/fixtures/apps/BookStackApp_BookStack',
    ];
}
$p2Dir = $root.'/tests/fixtures/http/p2';
$ghDir = $root.'/tests/fixtures/http/github';
foreach ([$p2Dir, $ghDir] as $dir) {
    if (!is_dir($dir)) {
        mkdir($dir, 0777, true);
    }
}
$fetch = static function (string $url, array $headers): HttpResult {
    $ctx = stream_context_create(['http' => ['method' => 'GET', 'header' => implode("\r\n", array_merge(['User-Agent: lockrot-recorder'], $headers)), 'ignore_errors' => true, 'timeout' => 30]]);
    $body = @file_get_contents($url, false, $ctx);
    $status = 0;
    foreach ($http_response_header ?? [] as $line) {
        if (preg_match('{^HTTP/\S+\s+(\d{3})}', $line, $m) === 1) {
            $status = (int) $m[1];
        }
    }
    return new HttpResult($url, $status, $body === false ? null : $body, new \DateTimeImmutable('now', new \DateTimeZone('UTC')));
};
$trim = static function (string $body, string $name): string {
    $json = json_decode($body, true);
    if (!\is_array($json) || !isset($json['packages'][$name])) {
        return $body;
    }
    $json['packages'][$name] = array_map(static fn (array $v): array => array_intersect_key($v, array_flip(KEEP)), $json['packages'][$name]);
    unset($json['security-advisories']);
    return json_encode($json, \JSON_UNESCAPED_SLASHES);
};
$isRecorded = static function (string $path): bool {
    if (!is_file($path) || !is_readable($path)) {
        return false;
    }
    $body = file_get_contents($path);
    if ($body === false) {
        return false;
    }
    $envelope = json_decode($body, true);

    return \is_array($envelope) && ($envelope['status'] ?? 0) !== 0; // status 0 = transport failure while recording: fetch again
};
$io = new NullIO();
$composerConfig = Factory::createConfig($io);
$repositoryHttp = new ComposerHttpClient(Factory::createHttpDownloader($io, $composerConfig), $io, $composerConfig, new Clock());
$github = new GitHubApi();
$githubHeaders = GitHubApi::headersFor(getenv('GITHUB_TOKEN') ?: null);
$locator = new RepoLocator();
$recordP2 = static function (string $name) use ($p2Dir, $repositoryHttp, $trim, $isRecorded): void {
    foreach ([false, true] as $dev) {
        $url = REPOSITORY_BASE_URL.$name.($dev ? '~dev' : '').'.json';
        $path = RecordedHttpClient::pathFor($p2Dir, $url);
        if ($isRecorded($path)) {
            continue;
        }
        $result = $repositoryHttp->fetchAll([$url])[$url];
        $body = $result->body() === null ? null : $trim($result->body(), $name);
        file_put_contents($path, json_encode((new HttpResult($url, $result->status(), $body, $result->fetchedAt()))->toEnvelope(), \JSON_UNESCAPED_SLASHES));
        fwrite(STDERR, \sprintf("p2 %s%s %d\n", $name, $dev ? '~dev' : '', $result->status()));
    }
};
// The monorepos the analyzer may load to date a split package's branches (resources/monorepo-parents.json).
foreach (MonorepoParents::load()->candidates() as $parent) {
    $recordP2($parent);
}
$repos = [];
foreach ($fixtures as $fixture) {
    $lock = LockFile::fromFile($root.'/'.$fixture.'/composer.lock');
    foreach ($lock->packages(false) as $package) {
        if (!$package->isFromComposerRepository()) {
            continue;
        }
        $recordP2($package->name());
        $repo = $locator->locate($package->repositoryUrl());
        if ($repo !== null && $repo->forge() === RepoRef::GITHUB) {
            $repos[$repo->path()] = $repo;
        }
    }
}
foreach ($repos as $repo => $ref) {
    $url = $github->requests($ref, false)['repo'];
    $path = RecordedHttpClient::pathFor($ghDir, $url);
    if ($isRecorded($path)) {
        continue;
    }
    $result = $fetch($url, $githubHeaders);
    $json = $result->body() === null ? null : json_decode($result->body(), true);
    $body = \is_array($json) ? json_encode(array_intersect_key($json, array_flip(['full_name', 'archived', 'disabled', 'pushed_at', 'default_branch'])), \JSON_UNESCAPED_SLASHES) : $result->body();
    file_put_contents($path, json_encode((new HttpResult($url, $result->status(), $body === false ? null : $body, $result->fetchedAt()))->toEnvelope(), \JSON_UNESCAPED_SLASHES));
    fwrite(STDERR, "github {$repo} {$result->status()}\n");
    if ($result->status() === 403) {
        fwrite(STDERR, "rate limited; set GITHUB_TOKEN and re-run\n");
        exit(1);
    }
}
echo "recorded into tests/fixtures/http\n";
