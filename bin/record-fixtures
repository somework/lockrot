#!/usr/bin/env php
<?php

declare(strict_types=1);
// Records Composer repository (p2), advisory, GitHub and GitLab responses for the acceptance
// fixtures, so tests run offline.
// Usage: GITHUB_TOKEN=... bin/record-fixtures [--gitlab-domain=<host> ...] [--into=<dir>] [fixtureDir ...]
//
// It records packages and packages-dev: a `--dev` test replays them. The advisory answer is one
// packagist.org POST with every name that it records, whatever its origin, as lockrot's lookup sends it.
// A request sends a token only to the host that it names, not to the target of a redirect.
//
// The script trims each p2 body to KEEP and each forge body to the keys that its ForgeApi reads. A
// fixture with its own `http` directory keeps its answers there (p2, github, gitlab, advisories),
// so they move no other fixture's results. Its packages.drupal.org entries' p2 answers go to
// <fixtureDir>/http/p2. In such a fixture, a repository on a --gitlab-domain host gets its commits
// answer, asked anonymously, in <fixtureDir>/http/gitlab. The script records its project document
// only with a gitlab-token for that host from Composer's config (auth.json or COMPOSER_AUTH).
// Anonymously, GitLab leaves `archived` out. The script never writes the token. It records no
// Bitbucket answer. With --into, every fixture keeps its answers in <dir> as if <dir> were its own `http`
// directory, and the monorepo parents' p2 answers go to <dir>/p2 too. --into records no `~dev` answer and
// no packages-dev name, because the corpus runs read neither. It also records, in <dir>/repos, each
// further `composer` repository of a fixture's composer.json: its packages.json, the p2 answers of the
// locked names that it lists and its advisory answer. It writes no answer that Lockrot\Tests\Support\RecordedStatus::keeps()
// refuses, and it fetches such an envelope on disk again. It exits 1 when an answer stays unrecorded.
// It records a GitLab answer only with the status 200 or 404, and it stops on a 429.
// With --names=<name[~dev],…> and --into, it records only the p2 answers that it lists into <dir>, and appends
// each name to <dir>/names.json, which Lockrot\Tests\Support\FixtureCliRun::forRecording serves after the cache:
// a move check asks names that no lock lists, and `~dev` answers. --before=<ISO time> drops every version
// released after that instant, so the answers describe the moment of the other recordings, and it prints each one.
require __DIR__.'/../vendor/autoload.php';

use Composer\Factory;
use Composer\IO\NullIO;
use Composer\MetadataMinifier\MetadataMinifier;
use Lockrot\Clock;
use Lockrot\Composer\ComposerHttpClient;
use Lockrot\Data\Forge\GitHubApi;
use Lockrot\Data\Forge\GitLabApi;
use Lockrot\Data\Forge\RepoLocator;
use Lockrot\Data\Forge\RepoRef;
use Lockrot\Data\Http\HttpResult;
use Lockrot\Data\Http\RecordedHttpClient;
use Lockrot\Data\Repository\MonorepoParents;
use Lockrot\Lock\LockFile;
use Lockrot\Tests\Support\RecordedStatus;
use Lockrot\Tests\Support\RecorderHttp;
use Lockrot\Tests\Support\RecorderNames;

const KEEP = ['name', 'version', 'version_normalized', 'time', 'abandoned', 'source', 'require', 'conflict', 'provide', 'replace', 'type', 'extra'];
const REPOSITORY_BASE_URL = 'https://repo.packagist.org/p2/';
const ADVISORY_API_URL = 'https://packagist.org/api/security-advisories/';
const DRUPAL_NOTIFICATION = '{^https://packages\.drupal\.org/(\d+)/downloads$}';
const GITLAB_COMMIT_KEYS = ['committed_date'];
const GITLAB_PROJECT_KEYS = ['path_with_namespace', 'archived'];

$root = \dirname(__DIR__);
$fixtures = [];
$gitlabDomains = ['gitlab.com'];
$into = null;
$names = null;
$before = null;
foreach (\array_slice($argv, 1) as $arg) {
    if (strpos($arg, '--names=') === 0) {
        $names = array_values(array_filter(explode(',', substr($arg, \strlen('--names=')))));
    } elseif (strpos($arg, '--before=') === 0) {
        $before = new \DateTimeImmutable(substr($arg, \strlen('--before=')));
    } elseif (strpos($arg, '--into=') === 0) {
        $into = rtrim(substr($arg, \strlen('--into=')), '/');
    } elseif (strpos($arg, '--gitlab-domain=') === 0) {
        $gitlabDomains[] = substr($arg, \strlen('--gitlab-domain='));
    } else {
        $fixtures[] = $arg;
    }
}
if ($fixtures === []) {
    $fixtures = [
        'tests/fixtures/apps/wallabag_wallabag', 'tests/fixtures/apps/nextcloud_3rdparty', 'tests/fixtures/apps/matomo-org_matomo',
        'tests/fixtures/skeletons/laravel', 'tests/fixtures/apps/BookStackApp_BookStack',
    ];
}
$httpDir = $into ?? $root.'/tests/fixtures/http';
$p2Dir = $httpDir.'/p2';
$ghDir = $httpDir.'/github';
$advisoryDir = $httpDir.'/advisories';
foreach ($names === null ? [$p2Dir, $ghDir, $advisoryDir] : [] as $dir) {
    if (!is_dir($dir)) {
        mkdir($dir, 0777, true);
    }
}
$fetch = static fn (string $url, array $headers, ?string $post = null, bool $follow = true): HttpResult => RecorderHttp::fetch($url, $headers, $post, $follow, [RecorderHttp::class, 'stream']);
$trim = static function (string $body, string $name): string {
    $json = json_decode($body, true);
    if (!\is_array($json) || !isset($json['packages'][$name])) {
        return $body;
    }
    $json['packages'][$name] = array_map(static fn (array $v): array => array_intersect_key($v, array_flip(KEEP)), $json['packages'][$name]);
    unset($json['security-advisories']);
    return json_encode($json, \JSON_UNESCAPED_SLASHES);
};
$isRecorded = static fn (string $path): bool => RecordedStatus::isRecorded($path, false);
$unrecorded = 0;
$store = static function (string $path, HttpResult $result, ?string $body, bool $github = false) use (&$unrecorded): void {
    if (!RecordedStatus::keeps($result->status(), $github)) {
        @unlink($path);
        ++$unrecorded;
        fwrite(STDERR, \sprintf("not recorded: %s %d\n", $result->url(), $result->status()));

        return;
    }
    if (!is_dir(\dirname($path))) {
        mkdir(\dirname($path), 0777, true);
    }
    file_put_contents($path, json_encode((new HttpResult($result->url(), $result->status(), $body, $result->fetchedAt()))->toEnvelope(), \JSON_UNESCAPED_SLASHES));
};
$io = new NullIO();
$composerConfig = Factory::createConfig($io);
$repositoryHttp = new ComposerHttpClient(Factory::createHttpDownloader($io, $composerConfig), $io, $composerConfig, new Clock());
$github = new GitHubApi();
$githubHeaders = GitHubApi::headersFor(getenv('GITHUB_TOKEN') ?: null);
$locator = new RepoLocator($gitlabDomains);
$gitlab = new GitLabApi();
$gitlabTokens = $composerConfig->get('gitlab-token');
$record = static function (string $dir, HttpResult $result, ?string $body) use ($store): void {
    $store(RecordedHttpClient::pathFor($dir, $result->url()), $result, $body);
};
$keep = static function (?string $body, array $keys, bool $list): ?string {
    $json = $body === null ? null : json_decode($body, true);
    if (!\is_array($json)) {
        return $body;
    }
    $trimmed = $list ? array_map(static fn ($item): array => \is_array($item) ? array_intersect_key($item, array_flip($keys)) : [], \array_slice($json, 0, 1)) : array_intersect_key($json, array_flip($keys));

    return (string) json_encode($trimmed, \JSON_UNESCAPED_SLASHES);
};
$recordP2 = static function (string $name, ?string $ownDir = null) use ($p2Dir, $repositoryHttp, $trim, $isRecorded, $into, $store): void {
    foreach ($into === null ? [false, true] : [false] as $dev) {
        $url = REPOSITORY_BASE_URL.$name.($dev ? '~dev' : '').'.json';
        $path = RecordedHttpClient::pathFor($ownDir ?? $p2Dir, $url);
        if ($isRecorded($path) || $isRecorded(RecordedHttpClient::pathFor($p2Dir, $url))) {
            continue;
        }
        $result = $repositoryHttp->fetchAll([$url])[$url];
        $store($path, $result, $result->body() === null ? null : $trim($result->body(), $name));
        fwrite(STDERR, \sprintf("p2 %s%s %d\n", $name, $dev ? '~dev' : '', $result->status()));
    }
};
if ($names !== null) {
    if ($into === null) {
        fwrite(STDERR, "--names needs --into\n");
        exit(2);
    }
    if (!is_dir($into)) {
        mkdir($into, 0777, true);
    }
    // A minified p2 list repeats only what changed from the version before it: expand it before a version goes.
    $trimBefore = static function (string $body, string $name) use ($before): array {
        $json = json_decode($body, true);
        if (!\is_array($json) || !isset($json['packages'][$name])) {
            return [$body, []];
        }
        $minified = ($json['minified'] ?? null) === 'composer/2.0';
        $versions = $minified ? MetadataMinifier::expand($json['packages'][$name]) : $json['packages'][$name];
        $dropped = [];
        $kept = [];
        foreach ($versions as $version) {
            if ($before !== null && isset($version['time']) && new \DateTimeImmutable($version['time']) > $before) {
                $dropped[] = $name.' '.$version['version'].' ('.$version['time'].')';
                continue;
            }
            $kept[] = array_intersect_key($version, array_flip(KEEP));
        }
        $json['packages'][$name] = $minified ? MetadataMinifier::minify($kept) : $kept;
        unset($json['security-advisories']);

        return [(string) json_encode($json, \JSON_UNESCAPED_SLASHES), $dropped];
    };
    $listed = is_file($into.'/names.json') ? json_decode((string) file_get_contents($into.'/names.json'), true) : [];
    $listed = \is_array($listed) ? $listed : [];
    foreach ($names as $entry) {
        $name = (string) preg_replace('/~dev$/', '', $entry);
        $listed[] = $name;
        $url = REPOSITORY_BASE_URL.$entry.'.json';
        $path = RecordedHttpClient::pathFor($into, $url);
        if ($isRecorded($path)) {
            continue;
        }
        $result = $repositoryHttp->fetchAll([$url])[$url];
        [$body, $dropped] = $result->body() === null ? [null, []] : $trimBefore($result->body(), $name);
        $store($path, $result, $body);
        fwrite(STDERR, \sprintf("p2 %s %d\n", $entry, $result->status()));
        foreach ($dropped as $line) {
            echo 'dropped '.$line."\n";
        }
    }
    $listed = array_values(array_unique($listed));
    sort($listed);
    file_put_contents($into.'/names.json', json_encode($listed, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES)."\n");
    echo "recorded into $into\n";
    exit(unrecorded($unrecorded));
}
/**
 * @param list<array{string, string}> $answers [p2 URL, recording directory], the first recorded one wins
 *
 * @return list<string> every source URL that the recorded p2 answer of $name names
 */
$releaseSources = static function (string $name, array $answers): array {
    $result = null;
    foreach ($answers as [$url, $dir]) {
        $raw = @file_get_contents(RecordedHttpClient::pathFor($dir, $url));
        $result = $result ?? ($raw === false ? null : HttpResult::fromEnvelopeJson($url, $raw));
    }
    $json = $result === null || $result->body() === null ? null : json_decode($result->body(), true);
    $urls = [];
    foreach (\is_array($json) ? $json['packages'][$name] ?? [] : [] as $version) {
        if (\is_string($version['source']['url'] ?? null)) {
            $urls[] = $version['source']['url'];
        }
    }

    return $urls;
};
/**
 * Each `composer` repository of the fixture's composer.json beside packagist.org: its packages.json,
 * the p2 answer of each locked name that its `available-packages` or `available-package-patterns` list,
 * and the answer of its advisory API for those names. A root that is no repository, or a repository
 * that lists locked names and has no `metadata-url`, counts as an unrecorded answer.
 */
$recordRepositories = static function (string $fixtureDir, LockFile $lock, string $dir) use ($fetch, $repositoryHttp, $record, $isRecorded, $trim, &$unrecorded): void {
    $manifest = json_decode((string) file_get_contents($fixtureDir.'/composer.json'), true);
    foreach (\is_array($manifest['repositories'] ?? null) ? $manifest['repositories'] : [] as $repository) {
        $url = \is_array($repository) && ($repository['type'] ?? null) === 'composer' && \is_string($repository['url'] ?? null) ? rtrim($repository['url'], '/') : null;
        if ($url === null || strpos($url, 'https://') !== 0 || parse_url($url, \PHP_URL_HOST) === 'repo.packagist.org') {
            continue;
        }
        $root = $url.'/packages.json';
        if (!$isRecorded(RecordedHttpClient::pathFor($dir, $root))) {
            $result = $fetch($root, []);
            $record($dir, $result, $result->body());
            fwrite(STDERR, \sprintf("repository %s %d\n", $root, $result->status()));
        }
        $result = HttpResult::fromEnvelopeJson($root, (string) @file_get_contents(RecordedHttpClient::pathFor($dir, $root)));
        $packages = $result === null || $result->body() === null ? null : json_decode($result->body(), true);
        if (!\is_array($packages)) {
            ++$unrecorded;
            fwrite(STDERR, \sprintf("not recorded: %s is no composer repository root\n", $root));
            continue;
        }
        $names = RecorderNames::repository($packages, array_map(static fn ($package): string => $package->name(), $lock->packages(false)));
        if ($names !== [] && !\is_string($packages['metadata-url'] ?? null)) {
            ++$unrecorded;
            fwrite(STDERR, \sprintf("not recorded: %s lists locked names and has no metadata-url\n", $root));
        }
        $port = parse_url($url, \PHP_URL_PORT);
        $base = (string) parse_url($url, \PHP_URL_SCHEME).'://'.(string) parse_url($url, \PHP_URL_HOST).($port === null || $port === false ? '' : ':'.$port);
        $resolve = static fn (string $target): string => preg_match('{^https?://}', $target) === 1 ? $target : $base.$target;
        foreach (\is_string($packages['metadata-url'] ?? null) ? $names : [] as $name) {
            $p2 = $resolve(str_replace('%package%', $name, $packages['metadata-url']));
            if (!$isRecorded(RecordedHttpClient::pathFor($dir, $p2))) {
                $answer = $repositoryHttp->fetchAll([$p2])[$p2];
                $record($dir, $answer, $answer->body() === null ? null : $trim($answer->body(), $name));
                fwrite(STDERR, \sprintf("p2 %s %d\n", $p2, $answer->status()));
            }
        }
        $api = $packages['security-advisories']['api-url'] ?? null;
        $api = \is_string($api) ? $resolve($api) : null;
        if ($api !== null && $names !== [] && !$isRecorded(RecordedHttpClient::pathFor($dir, $api))) {
            $answer = $fetch($api, ['Content-Type: application/x-www-form-urlencoded'], http_build_query(['packages' => $names]));
            $record($dir, $answer, $answer->body());
            fwrite(STDERR, \sprintf("advisories %s (%d names) %d\n", $api, \count($names), $answer->status()));
        }
    }
};
// The monorepos that the analyzer can load to date the branches of a split package.
foreach (MonorepoParents::load()->candidates() as $parent) {
    $recordP2($parent);
}
$repos = [];
$gitlabRepos = [];
foreach ($fixtures as $fixture) {
    $lock = LockFile::fromFile($root.'/'.$fixture.'/composer.lock');
    $own = $into ?? (is_dir($root.'/'.$fixture.'/http') ? $root.'/'.$fixture.'/http' : null);
    $notificationUrls = [];
    $rawLock = json_decode((string) file_get_contents($root.'/'.$fixture.'/composer.lock'), true);
    foreach (array_merge($rawLock['packages'] ?? [], $rawLock['packages-dev'] ?? []) as $entry) {
        $notificationUrls[$entry['name']] = $entry['notification-url'] ?? '';
    }
    $advisoryPath = ($own !== null ? $own.'/advisories' : $advisoryDir).'/'.basename($fixture).'.json';
    if (!$isRecorded($advisoryPath)) {
        $names = RecorderNames::advisory($lock, $into !== null);
        $result = $fetch(ADVISORY_API_URL, ['Content-Type: application/x-www-form-urlencoded'], http_build_query(['packages' => $names]));
        $store($advisoryPath, $result, $result->body());
        fwrite(STDERR, \sprintf("advisories %s (%d names) %d\n", $fixture, \count($names), $result->status()));
    }
    if ($into !== null) {
        $recordRepositories($root.'/'.$fixture, $lock, $into.'/repos');
    }
    foreach ($lock->packages($into === null) as $package) {
        if (!$package->isFromComposerRepository()) {
            continue;
        }
        $sourceUrl = $package->repositoryUrl();
        $answers = [[REPOSITORY_BASE_URL.$package->name().'.json', $own !== null ? $own.'/p2' : $p2Dir], [REPOSITORY_BASE_URL.$package->name().'.json', $p2Dir]];
        if (preg_match(DRUPAL_NOTIFICATION, $notificationUrls[$package->name()] ?? '', $m) === 1) {
            $answers = [['https://packages.drupal.org/files/packages/'.$m[1].'/p2/'.$package->name().'.json', $own !== null ? $own.'/p2' : $p2Dir]];
            foreach ($into === null ? ['', '~dev'] : [''] as $suffix) {
                $url = 'https://packages.drupal.org/files/packages/'.$m[1].'/p2/'.$package->name().$suffix.'.json';
                $dir = $own !== null ? $own.'/p2' : $p2Dir;
                if (!$isRecorded(RecordedHttpClient::pathFor($dir, $url))) {
                    $result = $repositoryHttp->fetchAll([$url])[$url];
                    $record($dir, $result, $result->body() === null ? null : $trim($result->body(), $package->name()));
                    fwrite(STDERR, \sprintf("p2 %s %d\n", $url, $result->status()));
                }
            }
        } else {
            $recordP2($package->name(), $own !== null ? $own.'/p2' : null);
        }
        // lockrot asks the repository of the highest release, which a renamed or moved project changes.
        foreach (array_unique(array_merge([$sourceUrl], $releaseSources($package->name(), $answers))) as $url) {
            $repo = $locator->locate($url);
            if ($repo !== null && $repo->forge() === RepoRef::GITHUB) {
                $githubDir = $own !== null ? $own.'/github' : $ghDir;
                $repos[$githubDir.'|'.$repo->path()] = [$repo, $githubDir];
            }
            if ($own !== null && $repo !== null && $repo->forge() === RepoRef::GITLAB) {
                $gitlabRepos[$own.'|'.$repo->key()] = [$repo, $own.'/gitlab'];
            }
        }
    }
}
foreach ($gitlabRepos as [$ref, $dir]) {
    $token = \is_array($gitlabTokens) ? ($gitlabTokens[$ref->host()] ?? null) : null;
    if ($token !== null && !\is_string($token)) {
        fwrite(STDERR, \sprintf("gitlab-token for %s is not a string; the project document is not recorded\n", $ref->host()));
        $token = null;
    }
    $requests = $gitlab->requests($ref, $token !== null);
    foreach ($requests as $role => $url) {
        if ($isRecorded(RecordedHttpClient::pathFor($dir, $url))) {
            continue;
        }
        $result = $fetch($url, $gitlab->headers($role === 'project' ? $token : null), null, $role !== 'project');
        fwrite(STDERR, \sprintf("gitlab %s %s %d\n", $ref->key(), $role, $result->status()));
        if ($result->status() === 429) {
            fwrite(STDERR, "rate limited; wait for the window and re-run\n");
            exit(1);
        }
        if (\in_array($result->status(), [200, 404], true)) {
            $record($dir, $result, $keep($result->body(), $role === 'commits' ? GITLAB_COMMIT_KEYS : GITLAB_PROJECT_KEYS, $role === 'commits'));
        }
    }
}
foreach ($repos as [$ref, $dir]) {
    $url = $github->requests($ref, false)['repo'];
    $path = RecordedHttpClient::pathFor($dir, $url);
    if (RecordedStatus::isRecorded($path, true) || RecordedStatus::isRecorded(RecordedHttpClient::pathFor($ghDir, $url), true)) {
        continue;
    }
    $result = $fetch($url, $githubHeaders);
    $json = $result->body() === null ? null : json_decode($result->body(), true);
    $body = \is_array($json) ? json_encode(array_intersect_key($json, array_flip(['full_name', 'archived', 'disabled', 'pushed_at', 'default_branch'])), \JSON_UNESCAPED_SLASHES) : $result->body();
    $store($path, $result, $body === false ? null : $body, true);
    fwrite(STDERR, \sprintf("github %s %d\n", $ref->path(), $result->status()));
    if ($result->status() === 403) {
        fwrite(STDERR, "rate limited; set GITHUB_TOKEN and re-run\n");
        exit(1);
    }
}
echo "recorded into $httpDir\n";
exit(unrecorded($unrecorded));

/** The exit code of a run that left $count answers unrecorded. */
function unrecorded(int $count): int
{
    if ($count === 0) {
        return 0;
    }
    fwrite(STDERR, \sprintf("%d answers not recorded; re-run to fetch them again\n", $count));

    return 1;
}
