#!/usr/bin/env bash
# Check that resources/report/ holds a plain release of the renderer, attested by the renderer's
# release workflow for the tag that the manifest names ("Which renderer a lockrot release vendors" in
# tools/report/README.md). The release pull request into main and the tag workflow run it.
#
#   tools/report/check-vendored     exit 1 on a pre-release or a local build, non-zero on a missing attestation
set -euo pipefail
cd "$(dirname "$0")/../.."

REPO=somework/lockrot-report
version=$(jq -r .version resources/report/manifest.json)
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "::error::resources/report/ holds lockrot-report $version, not a release"; exit 1; }
for file in report.html manifest.json; do
  gh attestation verify "resources/report/$file" --repo "$REPO" --signer-workflow "$REPO/.github/workflows/release.yml" --source-ref "refs/tags/v$version"
done
