<?xml version="1.0" encoding="UTF-8"?>
<!-- Shares testsuites/groups/php with phpunit.xml.dist (the everyday suite); its own <source>
     narrows to the fully unit-tested "core" for the coverage gate below. PHPUnit's CLI coverage
     filter option is repeatable on 9.6 and 11.5 but maps to directories only (11.5
     Cli/Builder.php:1109 to Configuration/Merger.php:795-797 to FilterDirectory), and this list
     includes single files, so a duplicate source block stays the only way to express it (ruling,
     .superpowers/sdd/2026-09-15-lockrot-v0.1.0-final/progress.md). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
        <testsuite name="e2e"><directory>tests/E2E</directory></testsuite>
    </testsuites>
    <groups><exclude><group>e2e</group><group>network</group></exclude></groups>
    <php><env name="LOCKROT_TODAY" value="2026-09-14T00:00:00+00:00"/></php>
    <source>
        <include>
            <directory>src/Verdict</directory>
            <directory>src/Signal</directory>
            <directory>src/Analyzer</directory>
            <directory>src/Data/Repository</directory>
            <directory>src/Lock</directory>
            <!-- install-time summary (added on feat/v0.1.0-prep): the plugin bootstrap around it
                 (LockrotPlugin, CommandProvider, LockrotCommand, ServiceFactory) is exercised by the
                 e2e group, which this gate excludes, so it stays in the informational run only -->
            <file>src/Deadline.php</file>
            <file>src/Composer/AnalyzerBootstrap.php</file>
            <file>src/Composer/InstallTimeSummary.php</file>
            <file>src/Composer/TransactionPackages.php</file>
            <file>src/Output/InstallSummaryFormatter.php</file>
            <file>src/Exception/InstallBlockedException.php</file>
            <!-- annotation formats (added on feat/v0.1.0-final): pure formatters over a Report, fully
                 unit-tested. LockLineIndex needs no entry of its own — src/Lock above already covers
                 it — and src/Version.php holds a constant with no executable line to measure -->
            <file>src/Output/FormatContext.php</file>
            <file>src/Output/GithubFormatter.php</file>
            <file>src/Output/SarifFormatter.php</file>
            <!-- gitlab + markdown formats (added on feat/v0.1.0-extras): pure formatters over a
                 Report, fully unit-tested, same as GithubFormatter/SarifFormatter above -->
            <file>src/Output/GitlabFormatter.php</file>
            <file>src/Output/MarkdownFormatter.php</file>
            <!-- baseline file (added on feat/v0.1.0-extras): value objects plus the one file lockrot
                 ever writes, all reachable from unit tests -->
            <directory>src/Baseline</directory>
            <!-- self-update (added on feat/self-update): the release lookup, the download/verify/
                 replace mechanics and the Phar check, all driven from unit tests with a fake HTTP
                 client and a temporary file. src/Composer/SelfUpdateCommand.php stays out, like
                 LockrotCommand, because its Composer wiring is only exercised by the e2e group -->
            <file>src/SelfUpdate/Release.php</file>
            <file>src/SelfUpdate/ReleaseLocator.php</file>
            <file>src/SelfUpdate/PharUpdater.php</file>
            <file>src/SelfUpdate/PharValidator.php</file>
            <file>src/SelfUpdate/PharValidatorInterface.php</file>
        </include>
    </source>
</phpunit>
