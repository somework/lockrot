<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep in step with phpunit.xml.dist. PHPUnit 9.6, on the PHP 7.4 and 8.0 legs, reads
     <coverage><include> where PHPUnit 10+ reads <source><include>. It cannot load the extension of
     phpunit.xml.dist, which uses the PHPUnit 10 extension API and acts only under Infection. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
        <testsuite name="e2e"><directory>tests/E2E</directory></testsuite>
    </testsuites>
    <groups><exclude><group>e2e</group><group>network</group><group>sweep</group></exclude></groups>
    <php><ini name="memory_limit" value="-1"/><env name="LOCKROT_TODAY" value="2026-09-14T00:00:00+00:00"/></php>
    <coverage><include><directory suffix=".php">src</directory></include></coverage>
</phpunit>
