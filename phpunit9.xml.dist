<?xml version="1.0" encoding="UTF-8"?>
<!-- Identical to phpunit.xml.dist except for the coverage element: PHPUnit 9.6, which the PHP 7.4
     and 8.0 matrix legs resolve, reads <coverage><include>, while 10+ reads <source><include>.
     ci.yml picks this file on those two legs. It also leaves out phpunit.xml.dist's extension,
     which is written against PHPUnit 10's extension API and only acts under Infection. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
        <testsuite name="e2e"><directory>tests/E2E</directory></testsuite>
    </testsuites>
    <groups><exclude><group>e2e</group><group>network</group></exclude></groups>
    <php><ini name="memory_limit" value="-1"/><env name="LOCKROT_TODAY" value="2026-09-14T00:00:00+00:00"/></php>
    <coverage><include><directory suffix=".php">src</directory></include></coverage>
</phpunit>
