{
    "source": {
        "directories": ["src"]
    },
    // Keep the cap far above the slowest covering run. Infection counts a timed-out mutant as
    // detected, and it skips a mutant whose covering tests alone reach the cap. A low cap lets the
    // gate pass with no test that kills the mutant. tests/Support/MutantTestTimeLimit.php stops an
    // endless loop per test instead. Evidence: https://github.com/somework/lockrot/pull/65
    "timeout": 600,
    // The covers-nothing group adds no line to the coverage, so the coverage run skips it. The
    // option replaces the exclude list of phpunit.xml.dist, so it repeats e2e, network and sweep.
    // Use one flag per group: PHPUnit warns on a comma list, and failOnWarning then fails every run.
    "testFrameworkOptions": "--exclude-group=e2e --exclude-group=network --exclude-group=sweep --exclude-group=covers-nothing",
    "logs": {
        "text": "build/infection.log"
    },
    "mutators": {
        "@default": true
    },
    // tests/infection-equivalents.md gives the reason that each tolerated escape is equivalent.
    // The floor is the whole-tree MSI rounded down, minus one. A few new escapes then do not fail
    // the gate, and the floor does not move with each new test.
    // Evidence: https://github.com/somework/lockrot/commit/05655c2a7a5f7b3189f45fcee13607f2b2cbeaa7
    "minMsi": 97,
    "minCoveredMsi": 97
}
