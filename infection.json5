{
    "source": {
        "directories": ["src/Verdict", "src/Signal"]
    },
    // The full suite takes ~30s on a developer machine, well past Infection's 10s default. With that
    // default, every mutant whose covering tests reach the integration suite came back as "required
    // more time than configured", which Infection counts as *detected*: 253 of 269 mutants timed out,
    // 16 were actually killed, and the gate still reported MSI 100% and exited 0, i.e. it could not
    // fail. A timeout has to exceed the slowest covering test run, not the fastest. With 180 no
    // mutant times out.
    "timeout": 180,
    "logs": {
        "text": "build/infection.log"
    },
    "mutators": {
        "@default": true
    },
    // Baseline over src/Verdict + src/Signal: 269 mutants, 264 killed, 5 escaped, 0 timed out ->
    // MSI = Covered MSI = 98.14%, 1m21s on 4 threads. All 5 escapes are in
    // src/Signal/ConstraintOpenness.php (CastInt, IncrementInteger, DecrementInteger,
    // ConcatOperandRemoval); each was checked by hand and is equivalent (numeric strings compare
    // numerically, every mutated integer stays below any PHP major, and normalize("8.4") equals
    // normalize("8.4.0")), so they are the honest floor of this scope, not a test gap.
    //
    // Extending source.directories to src/Output + src/Analyzer measures 1007 mutants, 941 killed,
    // 66 escaped, 0 timed out -> 93.45%, 3m42s, below this threshold. 59 of the 66 escapes are in
    // Analyzer.php and the formatters; the other 7 are equivalent mutants. Widening the scope means
    // closing those 59 first, which is a task of its own rather than a config flip.
    //
    // Threshold stays 94 (floor(98.14) - 3 would be 95; 94 is kept so the number does not move
    // every time a test is added).
    "minMsi": 94,
    "minCoveredMsi": 94
}
